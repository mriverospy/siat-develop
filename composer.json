{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.32",
        "laravelcollective/html": "^6.3",
        "barryvdh/laravel-debugbar": "^3.7",
        "soapbox/laravel-formatter": "^2.0",
        "barryvdh/laravel-snappy": "^1.0",
        "deviservi/nusoap": "^1.123",
        "venturecraft/revisionable": "^1.39",
        "sentry/sentry-laravel": "^2.13",
        "pda/pheanstalk": "^4.0",
        "maatwebsite/excel": "^3.1.41",
        "laravel/tinker": "^2.7",
        "shanmuga/laravel-entrust": "^3.0",
        "laravel/ui": "^4.0",
        "guzzlehttp/guzzle": "^7.2",
        "spatie/laravel-settings": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.10",
        "phpspec/phpspec": "^7.2",
        "mockery/mockery": "^1.4.4",
        "symfony/dom-crawler": "^6.0",
        "symfony/css-selector": "^6.0",
        "laravel/browser-kit-testing": "^6.3",
        "nunomaduro/collision": "^6.3",
        "fakerphp/faker": "^1.9.1",
        "spatie/laravel-ignition": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php",
            "tests/BrowserKitTestCase.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
